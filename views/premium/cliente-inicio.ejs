<%- include('../partials/cabecalho') %>
<%- include('../partials/menu-cliente') %>
<main class="conteudo">
  <div class="hero-premium">
    <div>
      <h1>Olá, <span class="grad"><%= discordNome %></span> 👋</h1>
      <p class="muted">Sua plataforma MONARCH está pronta</p>
    </div>
  </div>
  <div class="grid-kpis">
    <div class="kpi grande">
      <div class="kpi-label">💰 Saldo</div>
      <div class="kpi-valor">R$ <%= (carteira.saldo||0).toFixed(2) %></div>
      <div class="kpi-sub amarelo">Pendente: R$ <%= (carteira.pendente||0).toFixed(2) %></div>
    </div>
    <div class="kpi"><div class="kpi-label">📜 Licenças Ativas</div><div class="kpi-valor verde"><%= licencas.filter(l=>l.status==='ATIVA').length %></div></div>
    <div class="kpi"><div class="kpi-label">🤖 Meu Bot</div><div class="kpi-valor amarelo">PARA RESGATAR</div></div>
    <div class="kpi"><div class="kpi-label">⭐ Nível</div><div class="kpi-valor ciano">VERIFICADO</div></div>
  </div>

  <div class="onboarding card-premium">
    <h3>🚀 Vamos configurar tudo em 4 passos</h3>
    <div class="passos">
      <div class="passo ok">✅ Conta criada</div>
      <div class="passo ok">✅ Plano ativado</div>
      <div class="passo">⬜ Resgatar Bot</div>
      <div class="passo">⬜ Configurar Loja</div>
    </div>
    <a href="/painel/bot" class="btn-principal mt20">Continuar →</a>
  </div>
</main>
<%- include('../partials/rodape') %>
