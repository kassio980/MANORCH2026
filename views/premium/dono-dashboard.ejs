<%- include('../partials/cabecalho') %>
<%- include('../partials/menu-dono') %>
<main class="conteudo">
  <div class="hero-premium">
    <div>
      <h1>Boa noite, <span class="grad"><%= discordNome %></span> 👋</h1>
      <p class="muted">Resumo em tempo real de toda a plataforma</p>
    </div>
    <div class="acoes-rapidas">
      <button class="btn-principal">+ Novo Plano</button>
      <button class="btn-sec">+ Nova API</button>
      <button class="btn-sec">+ Produto</button>
      <button class="btn-sec">💸 Saques (<%= saquesPend %>)</button>
    </div>
  </div>

  <div class="grid-kpis">
    <div class="kpi grande">
      <div class="kpi-label">💰 Receita Total</div>
      <div class="kpi-valor">R$ <%= receita.toFixed(2).replace('.',',') %></div>
      <div class="kpi-sub verde">📈 +<%= cresc %>% este mês</div>
    </div>
    <div class="kpi"><div class="kpi-label">🛒 Vendas</div><div class="kpi-valor"><%= vendas %></div></div>
    <div class="kpi"><div class="kpi-label">👥 Clientes</div><div class="kpi-valor"><%= clientes %></div></div>
    <div class="kpi"><div class="kpi-label">🤖 Bots Online</div><div class="kpi-valor verde"><%= botsOn %></div></div>
  </div>

  <div class="grid-2">
    <div class="card-premium">
      <div class="card-topo"><h3>🔔 Atividade Recente</h3><a class="link">Ver tudo</a></div>
      <div class="timeline">
        <% ultimas.forEach(t => { %>
          <div class="tl-item">
            <span class="status-badge <%= t.status==='CONFIRMADO'?'verde':t.status==='PENDENTE'?'amarelo':'vermelho' %>"></span>
            <div><strong><%= t.tipo %> — R$ <%= t.valor.toFixed(2) %></strong><div class="muted-peq"><%= new Date(t.criado_em).toLocaleString('pt-BR') %></div></div>
          </div>
        <% }) %>
      </div>
    </div>
    <div class="card-premium">
      <div class="card-topo"><h3>⚡ Acesso Rápido</h3></div>
      <div class="atalhos">
        <a class="atalho" href="/dono/apis">🔑 APIs</a>
        <a class="atalho" href="/dono/bots">🤖 Bots</a>
        <a class="atalho" href="/dono/licencas">📜 Licenças</a>
        <a class="atalho" href="/dono/seguranca">🛡️ Segurança</a>
        <a class="atalho" href="/dono/analytics">📊 Analytics</a>
        <a class="atalho" href="/verificar">🛡️ Verificar</a>
      </div>
    </div>
  </div>
</main>
<%- include('../partials/rodape') %>
