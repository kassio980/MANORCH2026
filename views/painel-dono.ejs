<!DOCTYPE html><html><head><meta charset="UTF-8"><title><%= titulo %></title>
<link rel="stylesheet" href="/css/estilo.css"></head><body>
<header class="topo"><div class="logo">👑 PAINEL DONO</div>
<div class="user-logado">👤 <%= discordNome %> <a href="/auth/sair">Sair</a></div></header>
<main class="painel">
<h1>Bem-vindo de volta, <span class="destaque"><%= discordNome %></span></h1>
<div class="grid-metricas">
<div class="card"><h3>💰 RECEITA</h3><div class="valor">R$ <%= receita.toFixed(2) %></div></div>
<div class="card"><h3>👥 CLIENTES</h3><div class="valor"><%= clientes %></div></div>
<div class="card"><h3>📜 LICENÇAS</h3><div class="valor"><%= licencas %></div></div>
<div class="card"><h3>🤖 BOTS ONLINE</h3><div class="valor verde"><%= botsOnline %></div></div>
<div class="card"><h3>🛒 VENDAS</h3><div class="valor"><%= vendas %></div></div>
<div class="card"><h3>💸 SAQUES PENDENTES</h3><div class="valor amarelo"><%= saquesPendentes %></div></div>
</div></main></body></html>
