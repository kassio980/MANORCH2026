<!DOCTYPE html><html lang="pt-BR" class="tema-<%= tema %>">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title><%= titulo %> — MONARCH2026©</title>
<link rel="stylesheet" href="/css/estilo.css">
</head>
<body>
<header class="topo-barra">
  <span class="menu-mobile" onclick="document.getElementById('menu').classList.toggle('aberto')">☰</span>
  <form class="busca-global" onsubmit="return false">
    <input id="busca" placeholder="⌕ Pesquisar MONARCH... (CTRL + K)" autocomplete="off">
    <small>CTRL K</small>
    <div id="busca-result" class="busca-dropdown"></div>
  </form>
  <div class="icones-topo">
    <a href="/tema/<%= tema==='dark'?'light':'dark' %>" class="tema-btn" title="Tema"><%= tema==='dark'?'☀️':'🌙' %></a>
    <div class="sino" title="Notificações">🔔 <span class="badge"><%= notifCount %></span></div>
    <div class="perfil"><strong><%= discordNome %></strong> <a href="/auth/sair" class="sair">Sair</a></div>
  </div>
</header>
<script>
document.addEventListener('keydown', e => { if((e.ctrlKey||e.metaKey)&&e.key==='k'){e.preventDefault();document.getElementById('busca').focus();} });
let t; document.getElementById('busca').oninput = function(){
  clearTimeout(t); const q=this.value.trim(); const el=document.getElementById('busca-result');
  if(q.length<2){el.innerHTML='';return;}
  t=setTimeout(async()=>{
    const r = await (await fetch('/buscar',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({q})})).json();
    let h='';
    (r.licencas||[]).forEach(i=>h+=`<a class="br"><span class="tag">📜</span>${i.id} · ${i.plano}</a>`);
    (r.usuarios||[]).forEach(i=>h+=`<a class="br"><span class="tag">👤</span>${i.username}</a>`);
    (r.transacoes||[]).forEach(i=>h+=`<a class="br"><span class="tag">💳</span>R$ ${i.valor.toFixed(2)}</a>`);
    el.innerHTML = h || `<div class="br muted">Nenhum resultado</div>`;
  },200);
};
</script>
