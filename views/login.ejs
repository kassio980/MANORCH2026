<!DOCTYPE html><html lang="pt-BR"><head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>API+BOT — VENDAS OFICIAL</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{
  min-height:100vh;
  background:#05020D url('data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%22100%22 height=%22100%22><circle cx=%2210%22 cy=%2215%22 r=%221%22 fill=%22%238B5CF6%22 opacity=%22.3%22/><circle cx=%2285%22 cy=%2225%22 r=%221.5%22 fill=%22%238B5CF6%22 opacity=%22.2%22/><circle cx=%2225%22 cy=%2280%22 r=%221%22 fill=%22%238B5CF6%22 opacity=%22.25%22/><circle cx=%2290%22 cy=%2275%22 r=%221.2%22 fill=%22%238B5CF6%22 opacity=%22.3%22/></svg>');
  background-size:cover;
  font-family:'Segoe UI',system-ui,sans-serif;
  color:#fff;
  display:flex;align-items:center;justify-content:center;padding:20px;
  overflow-x:hidden;
}
.wrap{width:100%;max-width:520px;text-align:center;position:relative}

/* Efeito de luz de fundo */
.wrap::before{
  content:'';position:absolute;top:-120px;left:50%;transform:translateX(-50%);
  width:600px;height:600px;border-radius:50%;
  background:radial-gradient(circle,rgba(139,92,246,.35),transparent 65%);
  z-index:0;filter:blur(30px);
}
.inner{position:relative;z-index:1}

/* Robô + Título */
.hero{margin-bottom:14px}
.hex{
  width:220px;height:250px;margin:0 auto 10px;position:relative;
  background:
    linear-gradient(135deg,rgba(139,92,246,.4),rgba(59,130,246,.1)),
    linear-gradient(180deg,#1a0f35,#0a0618);
  clip-path:polygon(50% 0,100% 25%,100% 75%,50% 100%,0 75%,0 25%);
  display:flex;align-items:center;justify-content:center;
  box-shadow:0 0 60px rgba(139,92,246,.5),inset 0 0 40px rgba(139,92,246,.3);
  border:2px solid rgba(139,92,246,.6);
}
.robot{
  width:150px;height:170px;position:relative;
  filter:drop-shadow(0 0 20px rgba(139,92,246,.7));
}
.robot .head{
  width:120px;height:90px;margin:0 auto;border-radius:22px;
  background:linear-gradient(180deg,#2a2140,#120c24);
  border:2px solid rgba(139,92,246,.7);
  display:flex;align-items:center;justify-content:center;gap:18px;
  position:relative;
}
.robot .head::before{
  content:'';position:absolute;top:-14px;left:50%;transform:translateX(-50%);
  width:10px;height:14px;background:#8B5CF6;border-radius:3px 3px 0 0;
}
.robot .head::after{
  content:'';position:absolute;top:-22px;left:50%;transform:translateX(-50%);
  width:14px;height:14px;border-radius:50%;background:#C4B5FD;
  box-shadow:0 0 12px #fff;
}
.eye{
  width:28px;height:28px;border-radius:50%;
  background:radial-gradient(circle,#fff,#8B5CF6 40%,#5B21B6 80%);
  box-shadow:0 0 18px #8B5CF6,0 0 30px rgba(139,92,246,.8);
  animation:brilha 2s ease-in-out infinite;
}
.eye:nth-child(2){animation-delay:.3s}
@keyframes brilha{0%,100%{filter:brightness(1)}50%{filter:brightness(1.6)}}
.robot .body{
  width:110px;height:60px;margin:6px auto 0;border-radius:14px;
  background:linear-gradient(180deg,#2a2140,#120c24);
  border:2px solid rgba(139,92,246,.6);
  display:flex;align-items:center;justify-content:center;
  font-weight:900;font-size:26px;letter-spacing:2px;color:#fff;
  text-shadow:0 0 12px #8B5CF6;
}
.asas{
  position:absolute;top:70px;left:50%;transform:translateX(-50%);width:300px;height:80px;pointer-events:none;
}
.asas::before,.asas::after{
  content:'';position:absolute;top:0;width:110px;height:70px;
  background:linear-gradient(90deg,transparent,rgba(139,92,246,.5),#8B5CF6);
  clip-path:polygon(0 50%,100% 0,100% 100%);
  filter:drop-shadow(0 0 10px #8B5CF6);
}
.asas::before{left:-10px;transform:scaleX(-1)}
.asas::after{right:-10px}
.moedas{position:absolute;inset:-20px;pointer-events:none}
.moeda{
  position:absolute;width:34px;height:34px;border-radius:50%;
  background:radial-gradient(circle,#C4B5FD,#5B21B6 70%);
  border:2px solid #8B5CF6;display:flex;align-items:center;justify-content:center;
  font-weight:900;color:#fff;font-size:14px;
  box-shadow:0 0 14px rgba(139,92,246,.7);
  animation:flutua 4s ease-in-out infinite;
}
.moeda.m1{top:10px;left:10px;animation-delay:0s}
.moeda.m2{top:30px;right:20px;animation-delay:.6s;width:28px;height:28px}
.moeda.m3{bottom:40px;left:0;animation-delay:1.2s;width:24px;height:24px}
.moeda.m4{bottom:20px;right:10px;animation-delay:1.8s;width:30px;height:30px}
.moeda.m5{top:80px;right:-10px;animation-delay:.9s;width:22px;height:22px}
.moeda.m6{top:120px;left:-15px;animation-delay:2.2s;width:26px;height:26px}
@keyframes flutua{0%,100%{transform:translateY(0) rotate(0)}50%{transform:translateY(-14px) rotate(10deg)}}

h1{
  font-size:56px;font-weight:900;letter-spacing:2px;line-height:1;
  background:linear-gradient(180deg,#fff,#C4B5FD 60%,#8B5CF6);
  -webkit-background-clip:text;background-clip:text;color:transparent;
  text-shadow:0 0 30px rgba(139,92,246,.5);
  margin-top:6px;
}
.sub1{
  font-size:22px;font-weight:800;letter-spacing:6px;color:#C4B5FD;
  margin-top:2px;margin-bottom:14px;
}
.sub2{color:#A78BFA;font-size:14px;letter-spacing:3px;margin-bottom:24px}

/* Card login */
.card{
  background:linear-gradient(180deg,rgba(30,20,60,.85),rgba(10,6,24,.9));
  border:1.5px solid rgba(139,92,246,.5);
  border-radius:22px;padding:28px 24px;
  box-shadow:0 20px 60px rgba(0,0,0,.6),0 0 40px rgba(139,92,246,.2),inset 0 0 30px rgba(139,92,246,.08);
  backdrop-filter:blur(10px);
}
.card h2{font-size:28px;font-weight:800;margin-bottom:4px}
.card .desc{color:#94A3B8;font-size:14px;margin-bottom:20px}

.btn-discord{
  width:100%;padding:18px;border-radius:14px;border:0;cursor:pointer;
  background:linear-gradient(90deg,#6D28D9,#8B5CF6,#A78BFA);
  background-size:200% 100%;
  color:#fff;font-weight:900;font-size:18px;letter-spacing:.5px;
  display:flex;align-items:center;justify-content:center;gap:12px;
  box-shadow:0 10px 30px rgba(139,92,246,.5),inset 0 1px 0 rgba(255,255,255,.2);
  transition:.25s;
  position:relative;overflow:hidden;
}
.btn-discord::before{
  content:'';position:absolute;inset:0;border-radius:14px;
  box-shadow:inset 0 0 0 1.5px rgba(255,255,255,.25);pointer-events:none;
}
.btn-discord:hover{background-position:100% 0;transform:translateY(-2px);box-shadow:0 14px 40px rgba(139,92,246,.65)}
.btn-discord:active{transform:translateY(0)}
.btn-discord svg{width:28px;height:28px}
.btn-discord:disabled{opacity:.5;cursor:not-allowed;transform:none}

.ou{display:flex;align-items:center;gap:12px;margin:22px 0 14px;color:#64748B;font-size:12px;letter-spacing:2px}
.ou::before,.ou::after{content:'';flex:1;height:1px;background:linear-gradient(90deg,transparent,rgba(139,92,246,.4),transparent)}

.priv{
  display:flex;align-items:flex-start;gap:10px;text-align:left;
  font-size:14px;color:#CBD5E1;cursor:pointer;user-select:none;
}
.priv input{margin-top:3px;accent-color:#8B5CF6;width:18px;height:18px;cursor:pointer}
.priv a{color:#C4B5FD;font-weight:700;text-decoration:none}
.priv a:hover{color:#fff;text-decoration:underline}
.obg{background:rgba(139,92,246,.15);color:#C4B5FD;font-size:11px;padding:2px 8px;border-radius:999px;font-weight:700;margin-left:4px}
.seguro{color:#64748B;font-size:12px;margin-top:8px;text-align:left;padding-left:28px}

/* 3 cards */
.cards3{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:22px}
.card3{
  background:linear-gradient(180deg,rgba(30,20,60,.7),rgba(10,6,24,.8));
  border:1px solid rgba(139,92,246,.35);border-radius:14px;padding:14px 8px;
  transition:.2s;
}
.card3:hover{border-color:#8B5CF6;transform:translateY(-2px);box-shadow:0 8px 22px rgba(139,92,246,.25)}
.card3 .ic{font-size:26px;margin-bottom:4px}
.card3 .t{font-size:12px;font-weight:800;color:#fff;letter-spacing:.5px}
.card3 .d{font-size:10px;color:#94A3B8;margin-top:3px;line-height:1.3}

/* Rodapé */
.rodape{margin-top:26px;color:#64748B;font-size:12px}
.rodape .coroa{color:#C4B5FD;font-weight:800;letter-spacing:2px;margin-bottom:4px}
.rodape .coroa::before{content:'👑 '}

@media(max-width:520px){
  h1{font-size:42px}
  .sub1{font-size:17px;letter-spacing:4px}
  .hex{width:180px;height:205px}
  .robot{width:120px;height:140px}
  .asas{width:240px}
  .cards3{grid-template-columns:1fr;gap:8px}
}
</style>
</head><body>
<div class="wrap"><div class="inner">

  <!-- HERO: Robô + moedas + asas -->
  <div class="hero">
    <div class="hex">
      <div class="asas"></div>
      <div class="moedas">
        <div class="moeda m1">$</div><div class="moeda m2">$</div>
        <div class="moeda m3">$</div><div class="moeda m4">$</div>
        <div class="moeda m5">$</div><div class="moeda m6">$</div>
      </div>
      <div class="robot">
        <div class="head"><div class="eye"></div><div class="eye"></div></div>
        <div class="body">API</div>
      </div>
    </div>
    <h1>API+BOT</h1>
    <div class="sub1">VENDAS OFICIAL</div>
    <div class="sub2">AUTOMATIZE · VENDA · LUCRE MAIS</div>
  </div>

  <!-- CARD LOGIN -->
  <div class="card">
    <h2>FAÇA LOGIN</h2>
    <p class="desc">Acesse sua conta para continuar</p>

    <a href="/auth/discord" id="btnDiscord" class="btn-discord" onclick="
      if(!document.getElementById('priv').checked){
        event.preventDefault();
        alert('⚠️ Para continuar, você precisa aceitar a Política de Privacidade.');
        return false;
      }
    ">
      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.317 4.37A19.79 19.79 0 0 0 16.558 3c-.218.39-.47.91-.67 1.32a18.27 18.27 0 0 0-5.776 0 12.64 12.64 0 0 0-.678-1.32 19.736 19.736 0 0 0-3.759 1.37C2.43 9.046 1.55 13.58 2.0 18.05a19.9 19.9 0 0 0 6.03 3.03c.49-.67.92-1.38 1.3-2.13a12.9 12.9 0 0 1-2.07-.99c.17-.13.34-.26.5-.4a14.1 14.1 0 0 0 12.48 0c.16.14.33.27.5.4-.66.39-1.35.72-2.07.99.38.75.81 1.46 1.3 2.13a19.87 19.87 0 0 0 6.03-3.03c.53-5.17-.83-9.67-3.79-13.68ZM9.75 15.3c-1.18 0-2.16-1.08-2.16-2.42 0-1.33.96-2.42 2.16-2.42s2.18 1.09 2.16 2.42c0 1.34-.96 2.42-2.16 2.42Zm4.5 0c-1.18 0-2.16-1.08-2.16-2.42 0-1.33.96-2.42 2.16-2.42s2.18 1.09 2.16 2.42c0 1.34-.96 2.42-2.16 2.42Z"/></svg>
      FAZER LOGIN COM DISCORD
    </a>

    <div class="ou">OU</div>

    <label class="priv">
      <input type="checkbox" id="priv" required>
      <span>Li e aceito a <a href="/privacidade" target="_blank">Política de Privacidade</a><span class="obg">Obrigatório</span><br>
      <span class="seguro">🔒 Seus dados estão seguros conosco.</span></span>
    </label>
  </div>

  <!-- 3 CARDS -->
  <div class="cards3">
    <div class="card3"><div class="ic">🛡️</div><div class="t">100% SEGURO</div><div class="d">Seus dados protegidos com criptografia</div></div>
    <div class="card3"><div class="ic">⚡</div><div class="t">ENTREGA AUTOMÁTICA</div><div class="d">Receba sua API e BOT imediatamente</div></div>
    <div class="card3"><div class="ic">🎧</div><div class="t">SUPORTE 24/7</div><div class="d">Atendimento rápido e especializado</div></div>
  </div>

  <!-- RODAPÉ -->
  <div class="rodape">
    <div class="coroa">API VENDAS OFICIAL</div>
    © 2026 - Todos os direitos reservados
  </div>

</div></div>
</body></html>
