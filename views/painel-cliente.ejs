<!DOCTYPE html><html><head><meta charset="UTF-8"><title><%= titulo %></title>
<link rel="stylesheet" href="/css/estilo.css"></head><body>
<header class="topo"><div class="logo">👤 MEU PAINEL</div>
<div class="user-logado">👤 <%= discordNome %> <a href="/auth/sair">Sair</a></div></header>
<main class="painel">
<h1>Olá, <span class="destaque"><%= discordNome %></span> 👋</h1>
<div class="grid-metricas">
<div class="card"><h3>📜 MINHAS LICENÇAS</h3><div class="valor"><%= licencas.length %></div></div>
<div class="card"><h3>💰 SALDO</h3><div class="valor verde">R$ 0,00</div></div>
<div class="card"><h3>🤖 MEU BOT</h3><div class="valor amarelo">PARA RESGATAR</div></div>
</div>
<h2>Suas licenças ativas</h2>
<% licencas.forEach(l => { %>
<div class="item"><strong><%= l.id %></strong> • <%= l.plano %> • <span class="verde"><%= l.status %></span> • Expira: <%= new Date(l.validade).toLocaleDateString('pt-BR') %></div>
<% }) %>
</main></body></html>
