<%- include('../partials/cabecalho') %>
<%- include('../partials/topo-loja') %>
<%- include('../partials/menu-dono') %>
<main class="conteudo">
  <h1><span class="grad">💰 Minha Carteira MONARCH</span></h1>
  <div class="alerta verde centro-text">✅ VOCÊ NÃO PAGA TAXA NENHUMA — diferente dos membros</div>

  <div class="saldo-card">
    <div>
      <div class="sc-label">💵 SEU SALDO DISPONÍVEL</div>
      <div class="sc-valor">R$ <%= c.saldo.toFixed(2).replace('.',',') %></div>
      <div class="sc-sub">Recebe: vendas de produtos + 15% de todo saque da plataforma</div>
    </div>
  </div>

  <div class="grid-2 mt20">
    <!-- DEPOSITAR -->
    <div class="card-premium">
      <h3>📥 Depositar na plataforma</h3>
      <p class="muted-peq">Sem taxa · Sem limite · Imediato</p>
      <form method="POST" action="/dono/carteira/depositar" class="gap">
        <label>Valor</label>
        <input name="valor" type="number" step="0.01" min="<%= cfg.deposito_min %>" class="input" placeholder="R$ 0,00" required>
        <button class="btn-principal full">📥 DEPOSITAR</button>
      </form>
    </div>

    <!-- SACAR -->
    <div class="card-premium">
      <h3>💸 Sacar para sua conta</h3>
      <p class="muted-peq">Sem taxa · 0% · Todo valor vai pra você</p>
      <form method="POST" action="/dono/carteira/sacar" class="gap">
        <label>Chave Pix</label>
        <input name="chave_pix" class="input" placeholder="CPF / E-mail / Telefone" required>
        <label>Valor (mín R$ <%= cfg.saque_min.toFixed(2) %> / máx R$ <%= cfg.saque_max.toFixed(2) %>)</label>
        <input name="valor" type="number" step="0.01" min="<%= cfg.saque_min %>" max="<%= cfg.saque_max %>" class="input" placeholder="R$ 0,00" required id="vs" oninput="document.getElementById('lq').textContent='R$ '+((parseFloat(this.value)||0)).toFixed(2).replace('.',',')">
        <div class="tax">
          <span>Taxa MONARCH:</span><strong class="verde">0% (ISENTO)</strong>
          <span class="d">Você recebe:</span><strong class="verde" id="lq">R$ 0,00</strong>
        </div>
        <button class="btn-principal full">💸 SOLICITAR SAQUE</button>
      </form>
    </div>
  </div>

  <!-- RESUMO -->
  <div class="card-premium mt20">
    <h3>📊 Histórico</h3>
    <div class="grid-kpis">
      <div class="kpi"><div class="kpi-label">📦 Vendas produtos</div><div class="kpi-valor">R$ <%= c.total_vendas.toFixed(2).replace('.',',') %></div></div>
      <div class="kpi"><div class="kpi-label">📊 Taxas 15% recebidas</div><div class="kpi-valor roxo">R$ <%= c.total_taxas.toFixed(2).replace('.',',') %></div></div>
      <div class="kpi"><div class="kpi-label">💸 Total sacado</div><div class="kpi-valor">R$ <%= c.total_sacado.toFixed(2).replace('.',',') %></div></div>
      <div class="kpi"><div class="kpi-label">🏦 Saldo atual</div><div class="kpi-valor verde">R$ <%= c.saldo.toFixed(2).replace('.',',') %></div></div>
    </div>
  </div>
</main>
<%- include('../partials/rodape') %>
