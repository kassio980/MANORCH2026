<%- include('../partials/cabecalho') %>
<%- include('../partials/topo-loja') %>
<%- include('../partials/menu-dono') %>
<main class="conteudo">
  <h1><span class="grad">👥 Gerenciar Todos os Pedidos</span></h1>
  <p class="muted">Total: <%= pedidos.length %> pedidos</p>

  <div class="card-premium">
    <table class="tbl">
      <thead><tr><th>#</th><th>Cliente</th><th>Qtd</th><th>Valor</th><th>Status</th><th>Etapa</th><th>Ação</th></tr></thead>
      <tbody>
        <% pedidos.forEach(p => { %>
        <tr>
          <td><b>#<%= p.id %></b></td>
          <td><%= p.username %><br><small><%= p.discord_id %></small></td>
          <td><%= p.quantidade %> <%= p.refil?'🔁':'' %> <%= p.prioridade?'⚡':'' %></td>
          <td><b>R$ <%= p.valor_total.toFixed(2).replace('.',',') %></b><br><small class="roxo">+R$ <%= p.liquido_dono.toFixed(2).replace('.',',') %> líquido</small></td>
          <td><span class="sts <%= p.status %>"><%= p.status.replace('_',' ') %></span></td>
          <td><%= p.etapa %></td>
          <td>
            <% if(p.status==='AGUARDANDO_PAGAMENTO'){ %>
            <a href="/dono/membros/<%= p.id %>/confirmar" class="btn-peq verde">✅ Confirmar Pgto</a>
            <% } else { %>
            <span class="muted-peq">—</span>
            <% } %>
          </td>
        </tr>
        <% }) %>
        <% if(!pedidos.length){ %><tr><td colspan="7" class="centro-text muted">Nenhum pedido ainda</td></tr><% } %>
      </tbody>
    </table>
  </div>
</main>
<%- include('../partials/rodape') %>
