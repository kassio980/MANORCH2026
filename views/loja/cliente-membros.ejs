<%- include('../partials/cabecalho') %>
<%- include('../partials/topo-loja') %>
<%- include('../partials/menu-loja') %>
<main class="conteudo">
  <h1><span class="grad">👥 Comprar Membros</span></h1>
  <p class="muted">20 membros = R$ 1,00 · Entrega automática · 24/7</p>

  <!-- ✅ AVISO: QUEM NÃO ENTROU NO SERVIDOR NÃO COMPRA -->
  <% if(!entrou){ %>
  <div class="alerta-srv">
    <div class="as-ic">⚠️</div>
    <div>
      <strong>VOCÊ PRECISA ENTRAR NO SERVIDOR ANTES DE COMPRAR</strong>
      <p>Clica no botão abaixo, entra e volta aqui que liberamos automaticamente</p>
    </div>
    <a href="<%= convite %>" target="_blank" class="btn-srv">👉 ENTRAR NO SERVIDOR</a>
  </div>
  <% } else { %>
  <div class="alerta-ok">✅ Você já está no servidor · Compra liberada</div>
  <% } %>

  <div class="wrap-m">
    <div class="card-m">
      <!-- Cabeçalho -->
      <div class="cm-top">
        <div class="cm-e"><div class="cm-ic">👥</div><div><div class="cm-t">Configurar Pedido</div><div class="cm-s">Entrega estimada: imediata</div></div></div>
        <div class="live">● LIVE</div>
      </div>

      <!-- ✅ SLIDER PROFISSIONAL IGUAL A IMAGEM -->
      <div class="bloco">
        <div class="l1"><span class="lb">QUANTIDADE DE MEMBROS</span><span class="nq" id="nQ"><%= qtd %></span></div>
        <input type="range" id="sld" min="<%= c.membros_min %>" max="<%= c.membros_max %>" step="5" value="<%= qtd %>" class="sld">
        <div class="marc"><span><%= c.membros_min %></span><span><%= Math.round(c.membros_max/2) %></span><span><%= c.membros_max %>+</span></div>
      </div>

      <!-- ✅ REFIL +35% -->
      <label class="op">
        <div><div class="on">🔁 Refil Automático <span class="tg az">+<%= c.refil_pct %>%</span></div><div class="ds">Reposição automática em caso de saídas · 30 dias</div></div>
        <div class="sw"><input type="checkbox" id="rf" <%= refil?'checked':'' %>><i></i></div>
      </label>

      <!-- ✅ PRIORIDADE +R$4,50 -->
      <label class="op">
        <div><div class="on">⚡ Prioridade de Entrega <span class="tg am">+R$ <%= c.valor_prioridade.toFixed(2).replace('.',',') %></span></div><div class="ds">Fura a fila · Inicia instantaneamente</div></div>
        <div class="sw"><input type="checkbox" id="pr" <%= prio?'checked':'' %>><i></i></div>
      </label>

      <!-- ✅ TOTAL ATUALIZANDO AO VIVO -->
      <div class="tot">
        <div><div class="tl">TOTAL A PAGAR</div><div class="gw">● Gateway Online</div></div>
        <div class="tv" id="tV">R$ <%= calc.total.toFixed(2).replace('.',',') %></div>
      </div>

      <!-- RESUMO DETALHADO -->
      <div class="res">
        <div><span>Subtotal (<span id="rQ"><%= qtd %></span> membros)</span><b id="rS">R$ <%= (calc.total - (prio?c.valor_prioridade:0) - (refil?calc.total*c.refil_pct/100/(1+c.refil_pct/100):0)).toFixed(2).replace('.',',') %></b></div>
        <div id="rR" style="display:<%= refil?'flex':'none' %>"><span>Refil automático (+<%= c.refil_pct %>%)</span><b class="az" id="rRv">R$ 0,00</b></div>
        <div id="rP" style="display:<%= prio?'flex':'none' %>"><span>Prioridade entrega</span><b class="am">R$ <%= c.valor_prioridade.toFixed(2).replace('.',',') %></b></div>
        <div class="t45"><span>Taxa plataforma (45% já inclusa)</span><b class="roxo" id="rT">R$ <%= calc.taxa.toFixed(2).replace('.',',') %></b></div>
      </div>

      <form method="POST" action="/painel/membros/comprar" id="fC">
        <input type="hidden" name="qtd" id="fQ" value="<%= qtd %>">
        <input type="hidden" name="refil" id="fR" value="<%= refil?1:0 %>">
        <input type="hidden" name="prio" id="fP" value="<%= prio?1:0 %>">
        <button class="btn-buy" type="submit" <%= !entrou?'disabled style="opacity:.5;cursor:not-allowed"':'' %>>🛒 COMPRAR AGORA</button>
      </form>
      <div class="seg">🔒 Ambiente seguro · Processado via Asaas Payments</div>
    </div>

    <!-- LATERAL: STATS + ATIVIDADE -->
    <div class="lateral">
      <div class="grid3">
        <div class="kpi"><div class="k1">59+</div><div class="k2">MEMBROS</div></div>
        <div class="kpi"><div class="k1">100%</div><div class="k2">SEGURO</div></div>
        <div class="kpi"><div class="k1">24/7</div><div class="k2">SUPORTE</div></div>
      </div>
      <div class="ativ">
        <div class="at"><span class="pt">● AO VIVO</span><span class="at2">Atividade Recente</span></div>
        <div class="ml"><div class="av">m1g***</div><div class="ad">Entrou em <b>Rei dos Membros</b></div></div>
        <div class="ml"><div class="av">fxz***</div><div class="ad">Comprou <b>100 membros</b></div></div>
        <div class="ml"><div class="av">kss***</div><div class="ad">Entrou em <b>VIP MONARCH</b></div></div>
        <div class="ml"><div class="av">plk***</div><div class="ad">Comprou <b>500 membros</b></div></div>
      </div>
    </div>
  </div>
</main>

<!-- ✅ JS: MEXEU NO SLIDER JÁ CALCULA TUDO -->
<script>
const CFG = { preco: <%= c.preco_base_20 %>, refil: <%= c.refil_pct %>, prio: <%= c.valor_prioridade %>, taxa: <%= c.taxa_membros_dono %>, min: <%= c.membros_min %>, max: <%= c.membros_max %> };
const $ = id => document.getElementById(id);
const fmt = v => 'R$ ' + (+v).toFixed(2).replace('.',',');
function calc(){
  const q = Math.max(CFG.min, Math.min(CFG.max, +$('sld').value));
  const rf = $('rf').checked, pr = $('pr').checked;
  const un = CFG.preco / 20;
  let t = +(q * un).toFixed(2);
  if(rf) t = +(t * (1 + CFG.refil/100)).toFixed(2);
  if(pr) t = +(t + CFG.prio).toFixed(2);
  const tx = +(t * CFG.taxa / 100).toFixed(2);
  const sub = +(q * un).toFixed(2);
  const vRf = rf ? +(sub * CFG.refil/100).toFixed(2) : 0;
  $('nQ').textContent = $('rQ').textContent = $('fQ').value = q;
  $('tV').textContent = fmt(t);
  $('rS').textContent = fmt(sub);
  $('rT').textContent = fmt(tx);
  $('rRv').textContent = fmt(vRf);
  $('rR').style.display = rf ? 'flex' : 'none';
  $('rP').style.display = pr ? 'flex' : 'none';
  $('fR').value = rf?1:0; $('fP').value = pr?1:0;
}
$sld = $('sld'); $rf = $('rf'); $pr = $('pr');
$sld.addEventListener('input', calc);
$rf.addEventListener('change', calc);
$pr.addEventListener('change', calc);
calc();
</script>
<%- include('../partials/rodape') %>
