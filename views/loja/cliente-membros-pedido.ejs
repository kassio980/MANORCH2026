<%- include('../partials/cabecalho') %>
<%- include('../partials/topo-loja') %>
<%- include('../partials/menu-loja') %>
<main class="conteudo">
  <h1><span class="grad">📦 Pedido #<%= p.id %></span></h1>

  <div class="ped-wrap">
    <!-- DADOS DO PEDIDO -->
    <div class="ped-card">
      <div class="p-status <%= p.status %>"><%= p.status.replace('_',' ') %></div>
      <h3>Resumo do pedido</h3>
      <div class="p-linha"><span>Quantidade</span><b><%= p.quantidade %> membros</b></div>
      <div class="p-linha"><span>Refil automático</span><b><%= p.refil?'✅ Ativado':'❌ Não' %></b></div>
      <div class="p-linha"><span>Prioridade</span><b><%= p.prioridade?'✅ +R$4,50':'❌ Não' %></b></div>
      <div class="p-linha tot"><span>Total pago</span><b class="verde">R$ <%= p.valor_total.toFixed(2).replace('.',',') %></b></div>
      <div class="p-linha"><span>Taxa plataforma (45%)</span><b>R$ <%= p.taxa_plataforma.toFixed(2).replace('.',',') %></b></div>
      <div class="p-linha"><span>Seu lucro</span><b class="roxo">R$ <%= p.liquido_dono.toFixed(2).replace('.',',') %></b></div>
      <div class="p-linha"><span>Etapa atual</span><b class="az"><%= p.etapa %></b></div>
    </div>

    <!-- PIX -->
    <% if(p.status==='AGUARDANDO_PAGAMENTO' && p.pix_copia_cola){ %>
    <div class="pix-card">
      <h3>💰 PIX COPIA E COLA</h3>
      <% if(p.pix_qr){ %><img src="<%= p.pix_qr %>" class="qr" alt="QR Code"><% } %>
      <textarea readonly class="pix-txt" onclick="this.select();navigator.clipboard.writeText(this.value);this.nextElementSibling.textContent='✅ COPIADO!'"><%= p.pix_copia_cola %></textarea>
      <div class="cp">📋 COPIAR CÓDIGO</div>
      <div class="aviso-pix">⏳ Após pagar, aguarde até 2 minutos para confirmação automática</div>
    </div>
    <% } %>
  </div>

  <!-- ✅ JANELA FLUTUANTE: PAGAMENTO CONFIRMADO → Pede ID Discord -->
  <% if(p.status==='PAGO' && p.etapa==='id_discord'){ %>
  <div class="modal-fundo" id="md">
    <div class="modal">
      <div class="m-top">✅ Pagamento confirmado!</div>
      <h3>Informe seu ID do Discord</h3>
      <p class="muted">Cola aqui o seu ID de usuário para liberarmos a entrega</p>
      <form method="POST" class="gap">
        <input name="discord_id" required class="input" placeholder="Ex: 123456789012345678" value="<%= p.id_discord_usuario||'' %>">
        <button class="btn-principal full">📤 ENVIAR</button>
      </form>
      <% if(!entrou){ %>
      <div class="alerta-srv mt15">
        <strong>⚠️ Você ainda não entrou no servidor</strong>
        <p>Entre primeiro para liberarmos</p>
        <a href="<%= c.servidor_convite %>" target="_blank" class="btn-srv mt10">👉 ENTRAR NO SERVIDOR</a>
      </div>
      <% } %>
    </div>
  </div>
  <script>document.getElementById('md').style.display='flex';</script>
  <% } %>

  <!-- ✅ BOT AVISOU NO DISCORD? MOSTRA STATUS -->
  <% if(p.etapa==='bot'){ %>
  <div class="alerta-ok">✅ ID recebido · Acesse seu Discord que o BOT já te mandou mensagem com os botões</div>
  <% } %>
</main>
<%- include('../partials/rodape') %>
