<%- include('../partials/cabecalho') %>
<%- include('../partials/topo-loja') %>
<%- include('../partials/menu-dono') %>
<main class="conteudo">
  <h1><span class="grad">⚙️ Configurações da Plataforma</span></h1>
  <p class="muted">Altera aqui → vale para TODOS os clientes automaticamente</p>

  <div class="grid-2">
    <!-- SUA CHAVE ASAAS -->
    <div class="card-premium">
      <h3>🏦 Sua Chave Asaas (MONARCH)</h3>
      <p class="muted-peq">Todas as vendas de produtos da plataforma e taxas de 15% caem aqui</p>
      <form method="POST" class="gap">
        <label>Chave Mestre (live)</label>
        <input name="chave_asaas_dono" value="<%= c.chave_asaas_dono %>" class="input" placeholder="$aact_prod_...">
        <button class="btn-principal full">💾 Salvar Chave</button>
      </form>
    </div>

    <!-- TAXA E LIMITES GLOBAIS -->
    <div class="card-premium">
      <h3>💸 Regras de Dinheiro</h3>
      <p class="muted-peq">A taxa abaixo é descontada de todo saque de membro/dono de bot e vai pro seu saldo</p>
      <form method="POST" class="gap">
        <label>📊 Taxa de saque dos membros (%)
          <input name="taxa_saque_membros" type="number" step="0.1" value="<%= c.taxa_saque_membros %>" required class="input">
        </label>
        <div class="dois-campos">
          <label>💸 Saque Mínimo<input name="saque_min" type="number" step="0.01" value="<%= c.saque_min %>" class="input"></label>
          <label>💸 Saque Máximo<input name="saque_max" type="number" step="0.01" value="<%= c.saque_max %>" class="input"></label>
        </div>
        <div class="dois-campos">
          <label>📥 Depósito Mínimo<input name="deposito_min" type="number" step="0.01" value="<%= c.deposito_min %>" class="input"></label>
          <label>📥 Depósito Máximo<input name="deposito_max" type="number" step="0.01" value="<%= c.deposito_max %>" class="input"></label>
        </div>
        <button class="btn-principal full">💾 Salvar Regras</button>
      </form>
    </div>
  </div>

  <!-- RESUMO SUA CARTEIRA -->
  <div class="card-premium mt20">
    <h3>💹 Resumo do Caixa MONARCH</h3>
    <div class="grid-kpis">
      <div class="kpi"><div class="kpi-label">💵 Seu Saldo</div><div class="kpi-valor verde">R$ <%= sua_carteira.saldo.toFixed(2).replace('.',',') %></div></div>
      <div class="kpi"><div class="kpi-label">📦 Total Vendas Produtos</div><div class="kpi-valor">R$ <%= sua_carteira.total_vendas.toFixed(2).replace('.',',') %></div></div>
      <div class="kpi"><div class="kpi-label">📊 Total Taxas 15%</div><div class="kpi-valor roxo">R$ <%= sua_carteira.total_taxas.toFixed(2).replace('.',',') %></div></div>
      <div class="kpi"><div class="kpi-label">💸 Total Sacado</div><div class="kpi-valor">R$ <%= sua_carteira.total_sacado.toFixed(2).replace('.',',') %></div></div>
    </div>
  </div>
</main>
<%- include('../partials/rodape') %>
